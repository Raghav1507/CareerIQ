# ============================================================================
# CareerIQ - environment configuration (copy to .env and fill in values)
# Works on Windows and macOS. Never commit real secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Database
# Supabase local stack (npx supabase start) uses port 54321.
# docker-compose db service uses port 5432.
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54321/postgres

# ----------------------------------------------------------------------------
# Supabase (Authentication, Storage, PostgREST)
# Local: values are printed by `npx supabase start`
# Hosted: Dashboard -> Project Settings -> API
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# AI service (FastAPI) - server-side only, never expose to the browser
# ----------------------------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret between Next.js server and FastAPI (generate a long random value)
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# ----------------------------------------------------------------------------
# LLM provider (optional for foundation, required for AI explanations)
# LLM_PROVIDER = none | gemini | openai
# ----------------------------------------------------------------------------
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# AI service runtime
# ----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
LOG_LEVEL=info
