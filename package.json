{
  "name": "careeriq",
  "version": "0.1.0",
  "private": true,
  "description": "CareerIQ - AI Career Intelligence Platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,ai -c cyan,magenta \"npm run dev:web\" \"npm run dev:ai\"",
    "dev:web": "npm run dev --workspace @careeriq/web",
    "dev:ai": "npm run dev --workspace @careeriq/ai-service",
    "build": "npm run build --workspace @careeriq/web",
    "start:web": "npm run start --workspace @careeriq/web",
    "lint": "npm run lint --workspace @careeriq/web",
    "typecheck": "npm run typecheck --workspace @careeriq/web",
    "test": "npm run test:web && npm run test:ai",
    "test:web": "npm run test --workspace @careeriq/web",
    "test:ai": "npm run test --workspace @careeriq/ai-service",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/migrate.mjs --reset",
    "embed": "npm run embed --workspace @careeriq/ai-service",
    "smoke": "node scripts/smoke.mjs",
    "load": "node scripts/load.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
