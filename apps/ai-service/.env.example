# CareerIQ AI service environment (copy to apps/ai-service/.env)

APP_NAME="CareerIQ AI Service"
ENVIRONMENT=development
LOG_LEVEL=info

# Shared secret with the Next.js server (must match root .env INTERNAL_API_KEY)
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# Supabase (for verifying end-user JWTs via JWKS)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

LLM_PROVIDER=none
# LLM provider: none | gemini (Gemini only — no OpenAI)
GEMINI_API_KEY=

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Processing limits
MAX_PDF_BYTES=10485760
MAX_PDF_PAGES=40

# CORS (browser never calls this service directly in production)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Postgres connection (skill catalogue for resume/job extraction)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
