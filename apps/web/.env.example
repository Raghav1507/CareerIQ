# CareerIQ web — copy to .env.local
# Local Supabase (`npx supabase start`) prints these values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only: Next.js Route Handlers call the FastAPI service with this key.
AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=change-me-to-a-long-random-secret
